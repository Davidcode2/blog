---
title: The Learning Corner
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="A software engineers personal blog. Sandbox for learning about tech, personal improvement and all kinds of other things. Expect errors.">
    <link rel="stylesheet" href="/css/output.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&amp;display=swap" rel="stylesheet">
    <link rel="icon" href="/assets/favicon/favicon.png">
    <link rel="icon" href="/assets/favicon/favicon512x512.png" sizes="512x512">
    <link rel="icon" href="/assets/favicon/favicon.ico" sizes="32x32">
    <link rel="icon" href="/assets/favicon/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/assets/favicon/apple-touch-icon.png"><!-- 180×180 -->
    <script defer src="https://analytics.jakob-lingel.dev/script.js" data-website-id="840d9613-4162-4eaf-be31-23204f5bf127"></script>
    <script>
      (() => {
        const savedTheme = localStorage.getItem("theme");
        const systemIsDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", savedTheme === "dark" || (!savedTheme && systemIsDark));
      })();
    </script>
    <title>{{ title }}</title>
  </head>
  <body>
  <div class="site-shell">
    <header class="site-header">
      <a class="site-name" href="/">The Learning Corner</a>
      <nav class="site-actions" aria-label="Site controls">
        <button class="text-control" id="terminal-menu-trigger" type="button" aria-haspopup="dialog" aria-controls="terminal-menu">
          menu <kbd>Ctrl K</kbd>
        </button>
        <button class="text-control" id="theme-toggle" type="button" aria-label="Change color theme">
          theme: <span id="theme-label">auto</span>
        </button>
        <a class="text-control" href="https://github.com/davidcode2" aria-label="Jakob on GitHub">github</a>
      </nav>
    </header>
    <main class="site-content">
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <span>The Learning Corner</span>
      <a href="/impressum">Impressum</a>
    </footer>
  </div>

  <dialog class="terminal-dialog" id="terminal-menu" aria-labelledby="terminal-title">
    <div class="terminal-window">
      <header class="terminal-titlebar">
        <span id="terminal-title">jakob@blog:~</span>
        <button id="terminal-close" class="terminal-close" type="button" aria-label="Close menu">×</button>
      </header>
      <div class="terminal-body">
        <label class="terminal-prompt" for="terminal-input">
          <span class="prompt-branch">main</span>
          <span class="prompt-host">blog</span><span aria-hidden="true">:</span><span class="prompt-path">~</span>
          <span class="prompt-symbol" aria-hidden="true">$</span>
          <span class="sr-only">Search posts or type ls</span>
          <input id="terminal-input" type="text" autocomplete="off" autocapitalize="none" spellcheck="false" aria-controls="terminal-results" aria-describedby="terminal-status">
        </label>
        <p class="terminal-status" id="terminal-status" aria-live="polite">type <code>ls</code> to list posts, or search by title</p>
        <div class="terminal-results" id="terminal-results" role="listbox" aria-label="Blog posts">
          {%- for post in collections.post %}
          <a class="terminal-result" href="{{ post.url }}" role="option" tabindex="-1" hidden
             data-search="{{ post.data.title | escape }} {{ post.fileSlug | escape }}"
             data-filename="{{ post.fileSlug | escape }}.md">
            <span class="terminal-filename">{{ post.fileSlug }}.md</span>
            <span class="terminal-post-title">{{ post.data.title }}</span>
          </a>
          {%- endfor %}
        </div>
        <footer class="terminal-help" aria-hidden="true">
          <span>↑↓ / ctrl+n,p navigate</span>
          <span>enter open</span>
          <span>esc close</span>
        </footer>
      </div>
    </div>
  </dialog>
  <script src="/assets/terminal-menu.js" defer></script>
  </body>
</html>
