---
layout: layout.njk
---

<aside class="intro">
  <p class="intro-kicker">Hi, I'm Jakob.</p>
  <p>This is a brain dump about software, learning, and whatever I am trying to understand next. Expect errors.</p>
</aside>
<section class="post-index" aria-labelledby="posts-heading">
  <h1 id="posts-heading">Writing</h1>
  <ol class="post-list">
    {%- for post in collections.post %}
    <li>
      <a class="post-link" href="{{ post.url }}">
        <span class="post-title">{{ post.data.title }}</span>
        <time datetime="{{ post.data.date | formatDate('yyyy-LL-dd') }}">{{ post.data.date | formatDate("LLL dd, yyyy") }}</time>
      </a>
    </li>
    {%- endfor %}
  </ol>
</section>
